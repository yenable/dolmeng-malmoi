rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'lyy8867@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 글자 수 등 자세한 판정은 클라이언트(React)에서 한다.
    // 여기서는 악의적이거나 비정상적인 데이터만 막는 느슨한 안전망 역할만 한다.
    match /letters/{letterId} {
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40 &&
        request.resource.data.number is string &&
        request.resource.data.number.size() > 0 && request.resource.data.number.size() <= 10 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 8000 &&
        request.resource.data.charCount is int &&
        request.resource.data.createdAt == request.time;

      // 관리자는 status를 바꿀 수 있다(승인/반려).
      // 그 외에는 누구나(로그인 없음) 제목·내용만 고칠 수 있는데, 대신 반드시 다시 'pending'으로
      // 돌아가 선생님 재승인을 받아야 한다 — 로그인이 없어 "글쓴이 본인"을 서버에서 증명할 수
      // 없으므로, 수정은 항상 재검수를 거치게 해서 피해 범위를 "교사 승인 전 상태로 되돌리기"로 제한한다.
      allow update: if isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'text', 'charCount', 'status', 'editedAt']) &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.number == resource.data.number &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.status == 'pending' &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 8000 &&
          request.resource.data.charCount is int
        );

      allow delete: if isAdmin();
    }

    // 사전별 "~에 담긴 이야기" 답변. 학생 기기마다 무작위 id 문서 하나를 계속 덮어쓴다.
    // 읽기·목록은 선생님만. id 는 추측할 수 없는 무작위 값이라 남의 문서를 찾아 덮어쓰기 어렵다.
    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }
    function validBook(b) {
      return b is map &&
        b.keys().hasOnly(['word', 's1', 's2', 's3', 'completedAt']) &&
        shortStr(b.word, 2000) && shortStr(b.s1, 2000) &&
        shortStr(b.s2, 2000) && shortStr(b.s3, 2000) &&
        (b.completedAt == null || b.completedAt is int);
    }
    function validAnswers(d) {
      return d.keys().hasOnly(['name', 'number', 'books', 'updatedAt']) &&
        shortStr(d.name, 40) && shortStr(d.number, 10) &&
        d.books is map &&
        d.books.keys().hasOnly(['goyueo', 'jiyeogeo', 'hyundaeeo']) &&
        validBook(d.books.goyueo) && validBook(d.books.jiyeogeo) && validBook(d.books.hyundaeeo) &&
        d.updatedAt == request.time;
    }

    match /storyAnswers/{sessionId} {
      allow read, delete: if isAdmin();
      allow create, update: if sessionId.size() >= 16 && validAnswers(request.resource.data);
    }
  }
}
